{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comingsoon",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
